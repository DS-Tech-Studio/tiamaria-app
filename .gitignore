# Dependencias y paquetes
node_modules/
.pnp
.pnp.js

# Variables de entorno globales y secretos
.env
.env.*
!.env.example

# Logs y depuración
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Archivos del Sistema Operativo
.DS_Store
Thumbs.db

