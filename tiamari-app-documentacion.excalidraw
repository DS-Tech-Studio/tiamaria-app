    {
      "id": "pzX_9TFPSGXVIC7we-9Oi",
      "type": "text",
      "x": 42.42237065108384,
      "y": 786.3348027739365,
      "width": 507.279541015625,
      "height": 325,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3j",
      "roundness": null,
      "seed": 995769820,
      "version": 136,
      "versionNonce": 174771591,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792433004965,
      "link": null,
      "locked": false,
      "text": "CU-01: Autenticarse en el sistema (Login).\n\nCU-02: Registrar nuevo cliente.\n\nCU-03: Consultar catálogo de productos.\n\nCU-04: Crear y registrar un pedido (Vendedor).\n\nCU-05: Recibir notificación de nuevo pedido (Admin).\n\nCU-06: Visualizar lista de pedidos (Admin).\n\nCU-07: Crear / Editar productos (Admin).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CU-01: Autenticarse en el sistema (Login).\n\nCU-02: Registrar nuevo cliente.\n\nCU-03: Consultar catálogo de productos.\n\nCU-04: Crear y registrar un pedido (Vendedor).\n\nCU-05: Recibir notificación de nuevo pedido (Admin).\n\nCU-06: Visualizar lista de pedidos (Admin).\n\nCU-07: Crear / Editar productos (Admin).",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "-8jKFJjN64X-7z6QyVqu5",
      "type": "text",
      "x": 1198.357723031839,
      "y": 332.1688476998735,
      "width": 101.73991394042969,
      "height": 25,
      "angle": 0,
