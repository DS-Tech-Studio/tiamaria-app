      "boundElements": [],
      "updated": 1792433004965,
      "link": null,
      "locked": false,
      "text": "Desarrollar una aplicación web responsiva\nenfocada en dispositivos móviles para\noptimizar la gestión de ventas y producción,\npermitiendo el registro centralizado y\npersistente de clientes, productos y\npedidos, con notificaciones en tiempo real\npara la toma de pedidos.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Desarrollar una aplicación web responsiva enfocada en dispositivos móviles para optimizar la gestión de ventas y producción, permitiendo el registro centralizado y persistente de clientes, productos y pedidos, con notificaciones en tiempo real para la toma de pedidos.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
