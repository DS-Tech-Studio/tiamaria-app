    {
      "id": "4R3nkyFIt5WlobmgkPyHj",
      "type": "text",
      "x": 1792.2622744645896,
      "y": 13313.901424151385,
      "width": 967.57177734375,
      "height": 405,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
