    {
      "id": "R0a7Ag6HHZNooOfglzwiy",
      "type": "text",
      "x": 58.96719891331793,
      "y": 392.214637963781,
      "width": 374.7989501953125,
      "height": 121.78461239043251,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3R",
      "roundness": null,
      "seed": 763589852,
      "version": 144,
      "versionNonce": 214414151,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792433004965,
      "link": null,
      "locked": false,
      "text": "Administrador (Tu mamá):\nVisualiza y gestiona la lista global de pedidos.\nRecibe notificaciones automáticas de nuevos pedidos.\nGestiona el catálogo de productos y usuarios/perfiles.\n\nVendedor:\nRegistra clientes y pedidos desde el celular durante las ventas.\nConsulta el catálogo de productos disponibles.",
      "fontSize": 12.178461239043251,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Administrador (Tu mamá):\nVisualiza y gestiona la lista global de pedidos.\nRecibe notificaciones automáticas de nuevos pedidos.\nGestiona el catálogo de productos y usuarios/perfiles.\n\nVendedor:\nRegistra clientes y pedidos desde el celular durante las ventas.\nConsulta el catálogo de productos disponibles.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
    {
      "id": "4SLbhgi1TxOkFZ9f_y5vH",
