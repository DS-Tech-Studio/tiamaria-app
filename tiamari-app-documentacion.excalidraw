    {
      "id": "FuJjFks6RcUdKiFyXFjn9",
      "type": "text",
      "x": -3827.5152886133287,
      "y": 12164.800218249957,
      "width": 926.53173828125,
      "height": 2430,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
