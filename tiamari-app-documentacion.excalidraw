    {
      "id": "8Q4VDxEYem54I7ddXK7N3",
      "type": "text",
      "x": -519.7582024299006,
      "y": 404.13363419406596,
      "width": 428.5904405534534,
      "height": 175,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
